{
  "name": "kcsara-mail",
  "private": true,
  "type": "module",
  "description": "Receives email for the apps on port 25, checks SPF and DKIM, and POSTs each message to its domain's app",
  "scripts": {
    "build": "node build.mjs",
    "start": "node src/index.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "mailauth": "7.2.0",
    "mailparser": "3.9.37",
    "smtp-server": "3.19.18",
    "tldts": "7.4.18"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "nodemailer": "10.1.4"
  },
  "overrides": {
    "nodemailer": "10.1.4",
    "undici": "8.12.2"
  }
}

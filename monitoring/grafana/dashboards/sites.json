      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum(rate(loki_process_custom_site_requests_total{site=~\"$site\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(loki_process_custom_site_requests_total{site=~\"$site\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",

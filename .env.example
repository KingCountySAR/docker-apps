# Copy to .env (not committed) for your own settings. Read by `node deploy.mjs` and `node hydra.mjs`.

# Your ssh login on the VM: user@host, or a Host name from ~/.ssh/config (or give --host each time)
DEPLOY_HOST=

# Extra ssh options, like a key file or port (or give --ssh-options "..." each time). Quote a path with spaces.
# Use single quotes around the whole value: in double quotes, \n (as in C:\Users\nick) becomes a line break.
#DEPLOY_SSH_OPTIONS='-p 22 -i "C:\Users\Jo Smith\.ssh\vm_key"'

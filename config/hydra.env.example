# /srv/kcsara/config/hydra.env on the VM is made by setup-vm.sh, with random values: there's normally no need to write
# it by hand. Never commit the real file.

# Postgres sets this password for the hydra user when it first creates the database (data/postgres); changing it here
# afterwards doesn't change the database's.
POSTGRES_PASSWORD=
# The same password
DSN=postgres://hydra:<POSTGRES_PASSWORD>@postgres:5432/hydra?sslmode=disable
# Encrypts secrets in the database. At least 32 characters, e.g. from `openssl rand -hex 32`. To rotate, put the new
# one first and keep the old one after it, comma separated, until Hydra has re-encrypted with the new one.
SECRETS_SYSTEM=

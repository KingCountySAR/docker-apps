# /srv/kcsara/config/hydra.env on the VM is made by bin/secrets.sh, with random values: there's normally no need to
# write it by hand. Never commit the real file.

# Hydra's database in the shared postgres. hydra-db creates the hydra user and database from it, and sets the user's
# password to the one here (hex, so it needs no URL encoding).
DSN=postgres://hydra:<password>@postgres:5432/hydra?sslmode=disable
# Encrypts secrets in the database. At least 32 characters, e.g. from `openssl rand -hex 32`. To rotate, put the new
# one first and keep the old one after it, comma separated, until Hydra has re-encrypted with the new one.
SECRETS_SYSTEM=

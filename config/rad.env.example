# Copy to /srv/kcsara/config/rad.env on the VM, for the RAD portal (the rad service). Never commit the real file.

# The MongoDB Atlas connection string (Atlas → cluster → Connect → Drivers). Atlas's IP access list needs the VM's
# public IP.
MONGODB_URI=

# The Google OAuth Web client ID. Its Authorized JavaScript origins need the site's https address.
GOOGLE_ID=

# Comma-separated Google Workspace domains whose accounts may sign in.
ALLOWED_DOMAINS=

# Comma-separated emails that are always site admins, besides the ones added at /admin/settings.
SITE_ADMINS=

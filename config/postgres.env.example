# /srv/kcsara/config/postgres.env on the VM is made by bin/secrets.sh, with a random password: there's normally no need
# to write it by hand. Never commit the real file.

# The postgres superuser's password, for postgres/create-database.sh and `psql -U postgres`. Postgres sets it only when
# it first creates data/postgres; changing it here afterwards doesn't change the database's.
POSTGRES_PASSWORD=

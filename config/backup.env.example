# The backups to Azure Blob Storage (see "Backups" in the README): copy to /srv/kcsara/config/backup.env on the VM.
# Never commit the real file.

# The storage account, and one of its access keys (Azure portal → the storage account → Security + networking →
# Access keys).
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=

# Where in it: azure:<container>:/<folder>. `node deploy.mjs backup -- init` makes it, the container too (see "Backups"
# in the README).
RESTIC_REPOSITORY=azure:kcsara-backups:/vm

# Encrypts the backups: `openssl rand -base64 32`. Keep a copy off the VM, in a password manager: without it, the
# backups can't be read, by anyone. Never change it here once there are backups (`restic key` adds another).
RESTIC_PASSWORD=

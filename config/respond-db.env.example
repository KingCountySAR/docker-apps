# /srv/kcsara/config/respond-db.env on the VM is made by bin/secrets.sh, with a random password and key. Never commit
# the real file, and back it up: without SECRETS_KEY, the providers' client secrets in the database can't be read.

# Respond's database in the shared postgres. respond-db creates the respond user and database from it, and sets the
# user's password to the one here (hex, so it needs no URL encoding).
DATABASE_URL=postgres://respond:<password>@postgres:5432/respond

# Encrypts the client secrets of the member and sign-in providers in the database: 32 random bytes, in base64.
SECRETS_KEY=<key>

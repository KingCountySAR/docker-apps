# /srv/kcsara/config/reports-db.env on the VM is made by bin/secrets.sh, with a random password. Never commit the
# real file.

# KCSARA Reports' database in the shared postgres. reports-db creates the reporting user and database from it, and sets
# the user's password to the one here (hex, so it needs no URL encoding).
DATABASE_URL=postgres://reporting:<password>@postgres:5432/reporting

# Copy to /srv/kcsara/config/caddy.env on the VM (or, from the certbot.env that was there before Caddy:
# `sed s/CERTBOT_EMAIL/ACME_EMAIL/ config/certbot.env > config/caddy.env`).
# Let's Encrypt sends certificate expiry warnings here (only if renewing has been failing). A team or admin address.
ACME_EMAIL=

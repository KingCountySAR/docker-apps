# /srv/kcsara/config/grafana.env on the VM is made by bin/secrets.sh, with a random admin password. Never commit the
# real file. Grafana reads GF_<SECTION>_<KEY> variables, overriding monitoring/grafana/grafana.ini.

# The admin login (user admin). Grafana sets it only when it first creates data/grafana.
GF_SECURITY_ADMIN_PASSWORD=

# Google sign-in (see "Signing in to Grafana with Google" in the README)
#GF_AUTH_GOOGLE_ENABLED=true
#GF_AUTH_GOOGLE_CLIENT_ID=
#GF_AUTH_GOOGLE_CLIENT_SECRET=
#GF_AUTH_GOOGLE_ALLOWED_DOMAINS=

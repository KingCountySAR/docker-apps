# Copy to /srv/kcsara/config/cedar.env on the VM, for cedar (the cedar service). Never commit the real file: it has
# cedar's full-permission D4H token. See cedar's README for each setting.

# A D4H Team Manager Personal Access Token with full permissions, and the numeric team id clients can see.
D4H_TOKEN=
D4H_TEAM_ID=

# Hydra's issuer, exactly as in hydra/hydra.yml (urls.self.issuer): https://jwt.kingcountysar.org/, or the test name
# while Hydra runs under it. Tokens must name it. (cedar gets Hydra's keys from http://hydra:4444, JWT_URL in
# compose.yaml.)
JWT_ISSUER=https://jwt.kingcountysar.org/

# Optional: require this "aud" in client tokens.
#JWT_AUDIENCE=

#D4H_API_BASE=https://api.team-manager.us.d4h.com
LOG_LEVEL=info

# A custom field that can contain multiple emails, separated by , or ;
#SECONDARY_EMAIL_FIELD=
# A text custom field holding the name a member goes by, used as name.first (with legalFirst)
#NICKNAME_FIELD=

# Copy to /srv/kcsara/config/respond.env on the VM, for Respond (the respond service). Never commit the real file. Its
# database and SECRETS_KEY are in config/respond-db.env, made by bin/secrets.sh. Organizations, providers and site
# admins come from a seed file (`node deploy.mjs seed-respond <file>`) and the app's admin page, not from here.

# Comma-separated emails who are site admins on every site, beside those the admin page keeps.
SITE_ADMINS=

# Optional: a name for the build, which the app shows and sends to its clients.
#BUILD_ID=

# Optional: log every sync message, in and out. Noisy; for chasing a problem.
#SYNC_LOG=1

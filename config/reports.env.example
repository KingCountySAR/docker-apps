# Copy to /srv/kcsara/config/reports.env on the VM, for KCSARA Reports (the reports and reports-etl services). Never
# commit the real file. Its database is in config/reports-db.env, made by bin/secrets.sh.

# The Google OAuth Web client ID. Its Authorized JavaScript origins need https://reports.kingcountysar.org.
GOOGLE_ID=

# Comma-separated Google Workspace domains whose accounts may sign in and see reports.
ALLOWED_DOMAINS=

# Comma-separated emails that are admins (they see the data loads page).
SITE_ADMINS=

# The reports' Hydra client, for the ETL's reads of D4H through cedar. Make it with the scopes in db-reporting's
# docs/DESIGN.md: `node hydra.mjs create oauth2-client --name db-reporting --grant-type client_credentials --scope "..." --format json`.
CEDAR_CLIENT_ID=
CEDAR_CLIENT_SECRET=

# The ETL's settings, as in db-reporting's .env (see its docs/DESIGN.md).
LEGACY_UNTIL=2021-01-01T00:00:00-08:00
D4H_IMPORTED_UNTIL=2021-07-01T00:00:00-07:00
# LEGACY_BATCH_DAYS=UNIT:YYYY-MM-DD
# UNIT_ALIASES=OLDNAME=D4HNAME
# SECONDARY_EMAIL_FIELD=

# /srv/kcsara/config/postgres-exporter.env on the VM is made by bin/secrets.sh, with a random password. Never commit
# the real file.

# postgres-exporter-db creates this user, with pg_monitor's read-only access to postgres's statistics. Hex password.
DATA_SOURCE_NAME=postgres://postgres_exporter:<password>@postgres:5432/postgres?sslmode=disable
